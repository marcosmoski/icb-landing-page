# Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Instagram Feed (Opcional)
# Obtenha o token seguindo as instruções em INSTAGRAM_SETUP.md
VITE_INSTAGRAM_ACCESS_TOKEN=seu-instagram-token-aqui

# Edge Function (configure via `supabase functions secrets set`, nao no .env frontend):
# RESEND_API_KEY=...
# CHURCH_NOTIFICATION_EMAIL=igreja@seudominio.com
# RESEND_FROM_EMAIL="ICB Gaia <noreply@seudominio.com>"
